menu "BT Audio Basic Example (GMF)"

    config GMF_EXAMPLE_BT_DEVICE_NAME
        string "Bluetooth device name"
        default "ESP_BT_AUDIO"
        help
            Set the Bluetooth device name advertised by this example.

    config GMF_EXAMPLE_BT_DEVICE_NAME_APPEND_MAC
        bool "Append MAC address suffix to Bluetooth device name"
        default y
        help
            Append the last two bytes of the Bluetooth MAC address to the
            configured device name, for example esp_bt_audio_A1B2.

    menu "BT UI Configuration"

        config EXAMPLE_BT_UI_ENABLE
            bool "Enable LVGL UI"
            default y if IDF_TARGET_ESP32S31
            default n
            help
                Enable the on-device LVGL touch-screen UI (splash, media control,
                dialer, volume bar). Requires a board with LCD and touch
                support (e.g. ESP32-S31 Korvo1), as well as the LVGL, esp_lvgl_port,
                and esp_jpeg components in the project dependencies.

    endmenu

    config GMF_EXAMPLE_AUDIO_TECH_CLASSIC
        bool "Enable Classic Bluetooth"
        depends on BT_CLASSIC_ENABLED
        default y
        help
            Enable classic Bluetooth profile examples (A2DP/HFP/AVRCP/PBAP).

    menu "Classic Audio Roles Configuration"
        depends on BT_CLASSIC_ENABLED && GMF_EXAMPLE_AUDIO_TECH_CLASSIC

        choice
            prompt "A2DP role"
            depends on BT_A2DP_ENABLE
            default GMF_EXAMPLE_A2DP_SINK

        config GMF_EXAMPLE_A2DP_NONE
            bool "None"
            help
                Disable A2DP role

        config GMF_EXAMPLE_A2DP_SINK
            bool "A2DP Sink"
            help
                Enable A2DP Sink role

        config GMF_EXAMPLE_A2DP_SOURCE
            bool "A2DP Source"
            help
                Enable A2DP Source role

        endchoice

        choice
            prompt "HFP role"
            depends on BT_HFP_CLIENT_ENABLE || BT_HFP_AG_ENABLE
            default GMF_EXAMPLE_HFP_HF if BT_HFP_CLIENT_ENABLE
            default GMF_EXAMPLE_HFP_AG if BT_HFP_AG_ENABLE

        config GMF_EXAMPLE_HFP_NONE
            bool "None"
            help
                Disable HFP role

        config GMF_EXAMPLE_HFP_HF
            bool "HFP Handsfree"
            depends on BT_HFP_CLIENT_ENABLE
            help
                Enable HFP Handsfree role

        config GMF_EXAMPLE_HFP_AG
            bool "HFP Audio Gateway"
            depends on BT_HFP_AG_ENABLE
            help
                Enable HFP Audio Gateway role

        endchoice

        config GMF_EXAMPLE_AVRC_CT
            depends on BT_AVRCP_ENABLED
            bool "AVRC Controller"
            default y
            help
                Enable AVRC Controller role

        config GMF_EXAMPLE_AVRC_TG
            depends on BT_AVRCP_ENABLED
            bool "AVRC Target"
            default y
            help
                Enable AVRC Target role

        config GMF_EXAMPLE_PBAP_PCE
            depends on BT_PBAC_ENABLED && GMF_EXAMPLE_HFP_HF
            bool "Phone book client equipment"
            default n
            help
                Enable phone book client equipment role
    endmenu

    config GMF_EXAMPLE_AUDIO_TECH_LE
        bool "Enable LE Audio"
        depends on BT_AUDIO && BT_ISO
        default y
        help
            Enable LE Audio unicast server example flow. This option can be
            enabled together with Classic Bluetooth when the selected BT host
            and controller configuration support both technologies.

    menu "LE Audio Configuration"
        depends on GMF_EXAMPLE_AUDIO_TECH_LE

        choice
            prompt "LE Audio user case"
            default GMF_EXAMPLE_LE_USER_CASE_TMAP
            help
                Select the LE Audio user case used by the example.

        config GMF_EXAMPLE_LE_USER_CASE_TMAP
            bool "TMAP"
            help
                Enable the Telephony and Media Audio Profile user case.

        endchoice

        config GMF_EXAMPLE_LE_TMAP_ROLE_CT
            bool "TMAP call terminal role"
            depends on GMF_EXAMPLE_LE_USER_CASE_TMAP
            default y
            help
                Enable the TMAP Call Terminal role.

        config GMF_EXAMPLE_LE_TMAP_ROLE_UMR
            bool "TMAP unicast media receiver role"
            depends on GMF_EXAMPLE_LE_USER_CASE_TMAP
            default y
            help
                Enable the TMAP Unicast Media Receiver role.

        config GMF_EXAMPLE_LE_TMAP_ROLE_BMR
            bool "TMAP broadcast media receiver role"
            depends on GMF_EXAMPLE_LE_USER_CASE_TMAP
            default y
            help
                Enable the TMAP Broadcast Media Receiver role.

        config GMF_EXAMPLE_LE_TMAP_ROLE_BMS
            bool "TMAP broadcast media sender role"
            depends on GMF_EXAMPLE_LE_USER_CASE_TMAP && BT_BAP_BROADCAST_SOURCE
            default n
            help
                Enable the TMAP Broadcast Media Sender role. The example sends
                local microSD media files as an LC3 BIS broadcast source.

        config GMF_EXAMPLE_LE_BSRC_NAME
            string "LE Audio broadcast source name"
            depends on GMF_EXAMPLE_LE_TMAP_ROLE_BMS
            default "GMF_BIS_Source"
            help
                Set the Broadcast_Name field advertised by the BIS source.

        config GMF_EXAMPLE_LE_BSRC_CODE
            string "LE Audio broadcast code string (optional)"
            depends on GMF_EXAMPLE_LE_TMAP_ROLE_BMS
            default ""
            help
                Set the broadcast code as a plain string. The example copies up
                to 16 characters into the 16-byte Broadcast_Code field and pads
                the rest with zeros. Keep this empty to advertise an unencrypted
                broadcast.

        config GMF_EXAMPLE_LE_BSRC_STREAM_NUM
            int "LE Audio broadcast source stream count"
            depends on GMF_EXAMPLE_LE_TMAP_ROLE_BMS
            default 1
            range 1 2
            help
                Set the number of BIS source streams requested by the example.
                The esp_bt_audio component clamps this value to the ESP-IDF
                CONFIG_BT_BAP_BROADCAST_SRC_STREAM_COUNT limit.

        choice GMF_EXAMPLE_LE_LOCATION
            prompt "LE Audio location"
            default GMF_EXAMPLE_LE_LOCATION_FRONT_RIGHT

            config GMF_EXAMPLE_LE_LOCATION_FRONT_LEFT
                bool "Front left"
                help
                    Advertise the LE Audio front left location.

            config GMF_EXAMPLE_LE_LOCATION_FRONT_RIGHT
                bool "Front right"
                help
                    Advertise the LE Audio front right location.

            config GMF_EXAMPLE_LE_LOCATION_FRONT_LEFT_RIGHT
                bool "Front left and right"
                help
                    Advertise both LE Audio front left and front right locations.

        endchoice

        config GMF_EXAMPLE_LE_SOURCE_ENABLE
            bool "Enable LE Audio source capability"
            default y
            help
                Enable LE Audio source capability and source ASE count.

        config GMF_EXAMPLE_LE_COORDINATE_SET_SIZE
            int "LE Audio coordinate set size"
            default 2
            range 0 2
            help
                Set the CSIP coordinated set size advertised by the LE Audio example.

        config GMF_EXAMPLE_LE_COORDINATE_SET_RANK
            int
            default 1 if GMF_EXAMPLE_LE_LOCATION_FRONT_LEFT
            default 2 if GMF_EXAMPLE_LE_LOCATION_FRONT_RIGHT
            default 2 if GMF_EXAMPLE_LE_LOCATION_FRONT_LEFT_RIGHT
            default 2
            range 1 2
            help
                Set the CSIP rank for this set member based on the advertised location.

        config GMF_EXAMPLE_LE_CSIP_SIRK
            string "CSIP SIRK (16 hex bytes)"
            depends on GMF_EXAMPLE_LE_COORDINATE_SET_SIZE > 1
            default "b803aac6afbb65625a41f15305698f84"
            help
                CSIP Set Identity Resolving Key as 32 hex characters
                (representing 16 bytes). The default value matches the
                previously hardcoded SIRK.

        config GMF_EXAMPLE_LE_SCAN_TIMEOUT_MS
            int "Default LE scan timeout (ms)"
            default 10000
            range 1000 60000
            help
                Default timeout used by LE scan command.

    endmenu

endmenu
